        "    # char_to_int = {c: i for i, c in enumerate(alphabet)}\n",
        "    char_to_int={c:i for i, c in enumerate(alphabet)}\n",
        "    # For each string pattern in X, convert each character to its integer index\n",
        "    X_enc=[]\n",
        "    for pattern in X:\n",
        "      encoded=[char_to_int[ch] for ch in pattern]\n",
        "      X_enc.append(encoded)\n",
        "    # Do the same for y\n",
        "    y_enc=[]\n",
        "    for pattern in y:\n",
        "      encoded=[char_to_int[ch] for ch in pattern]\n",
        "      y_enc.append(encoded)\n",
        "    return X_enc,y_enc\n",
        "    # ─────────────────────────────────────────────────────────────────────────\n",
